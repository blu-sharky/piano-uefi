##
#  piano (Xiaomi Pad 8 Pro, SM8750) flash layout.
#  Modeled on dodgePkg; first-pass minimal DXE set, no closed-source DXE
#  (Binaries/), no DisplayDxe — SimpleFb on the ABL splash framebuffer only.
#
#  SPDX-License-Identifier: BSD-2-Clause-Patent
##

[FD.SILICIUM_UEFI]
BaseAddress   = $(FD_BASE)|gArmTokenSpaceGuid.PcdFdBaseAddress
Size          = $(FD_SIZE)|gArmTokenSpaceGuid.PcdFdSize
ErasePolarity = 1

# This one is tricky, it must be: BlockSize * NumBlocks = Size
BlockSize     = 0x1000
NumBlocks     = $(FD_BLOCKS)

0x00000000|$(FD_SIZE)
gArmTokenSpaceGuid.PcdFvBaseAddress|gArmTokenSpaceGuid.PcdFvSize
FV = FVMAIN_COMPACT

[FV.FvMain]
FvNameGuid         = 95710444-3230-42DD-B8CE-3412E78F2174
BlockSize          = 0x1000
NumBlocks          = 0        # This FV gets compressed so make it just big enough
FvAlignment        = 8
ERASE_POLARITY     = 1
MEMORY_MAPPED      = TRUE
STICKY_WRITE       = TRUE
LOCK_CAP           = TRUE
LOCK_STATUS        = TRUE
WRITE_DISABLED_CAP = TRUE
WRITE_ENABLED_CAP  = TRUE
WRITE_STATUS       = TRUE
WRITE_LOCK_CAP     = TRUE
WRITE_LOCK_STATUS  = TRUE
READ_DISABLED_CAP  = TRUE
READ_ENABLED_CAP   = TRUE
READ_STATUS        = TRUE
READ_LOCK_CAP      = TRUE
READ_LOCK_STATUS   = TRUE

  !include Include/APRIORI.inc
  !include Include/DXE.inc

  # RAM Manager — left out while the FV carries no SMEM driver: its
  # RamManagerLib constructor needs gEfiRamPartitionProtocol and asserts
  # with Not Found otherwise. The static memory map already covers
  # everything booted so far; bring it back together with SmemDxe.
  #INF SiliciumPkg/Drivers/RamManagerDxe/RamManagerDxe.inf

  # UFS: generic UFSHCI stack on the controller the bootloader left
  # running; UfsPlatformDxe refuses every non-read SCSI command
  INF pianoPkg/Drivers/UfsPlatformDxe/UfsPlatformDxe.inf
  INF MdeModulePkg/Bus/Pci/NonDiscoverablePciDeviceDxe/NonDiscoverablePciDeviceDxe.inf
  INF MdeModulePkg/Bus/Pci/UfsPciHcDxe/UfsPciHcDxe.inf
  INF MdeModulePkg/Bus/Ufs/UfsPassThruDxe/UfsPassThruDxe.inf
  INF MdeModulePkg/Bus/Scsi/ScsiBusDxe/ScsiBusDxe.inf
  INF MdeModulePkg/Bus/Scsi/ScsiDiskDxe/ScsiDiskDxe.inf

  # Keys: power and volume through the open keypad framework; the device
  # library only reads PMIC registers (no closed-source PMIC stack)
  INF SiliciumPkg/Drivers/KeypadDeviceDxe/KeypadDeviceDxe.inf
  INF SiliciumPkg/Drivers/KeypadDxe/KeypadDxe.inf

  # CrabApple boot manager: registrar + application (first boot option)
  INF CrabApplePkg/Driver/CrabAppleDxe/CrabAppleDxe.inf
  INF CrabApplePkg/Application/CrabApple/CrabApple.inf

  # Form browser. BDS repairs controllers through Driver Health before every
  # boot option (UefiBootManagerLib BmRepairAllControllers) and asserts when
  # gEfiFormBrowser2ProtocolGuid is missing. Other devices get it from
  # Extra.fdf.inc; only the browser itself is needed here.
  INF MdeModulePkg/Universal/SetupBrowserDxe/SetupBrowserDxe.inf

  # SmBios
  INF MdeModulePkg/Universal/SmbiosDxe/SmbiosDxe.inf
  INF SiliciumPkg/Drivers/SmBiosTableDxe/SmBiosTableDxe.inf

  # IORT DT
  INF QcomPkg/Drivers/IortDtDxe/IortDtDxe.inf

  # Device Tree
  INF EmbeddedPkg/Drivers/DtPlatformDxe/DtPlatformDxe.inf
  FILE FREEFORM = 25462CDA-221F-47DF-AC1D-259CFAA4E326 {
    SECTION RAW = pianoPkg/FdtBlob/sm8750-xiaomi-piano.dtb
    SECTION UI = "DeviceTreeBlob"
  }

[FV.FVMAIN_COMPACT]
FvAlignment        = 8
ERASE_POLARITY     = 1
MEMORY_MAPPED      = TRUE
STICKY_WRITE       = TRUE
LOCK_CAP           = TRUE
LOCK_STATUS        = TRUE
WRITE_DISABLED_CAP = TRUE
WRITE_ENABLED_CAP  = TRUE
WRITE_STATUS       = TRUE
WRITE_LOCK_CAP     = TRUE
WRITE_LOCK_STATUS  = TRUE
READ_DISABLED_CAP  = TRUE
READ_ENABLED_CAP   = TRUE
READ_STATUS        = TRUE
READ_LOCK_CAP      = TRUE
READ_LOCK_STATUS   = TRUE

  INF SiliciumPkg/Sec/Sec.inf

  FILE FV_IMAGE = 9E21FD93-9C72-4c15-8C4B-E77F1DB2D792 {
    SECTION GUIDED EE4E5898-3914-4259-9D6E-DC7BD79403CF PROCESSING_REQUIRED = TRUE {
      SECTION FV_IMAGE = FVMAIN
    }
  }

  !include SiliciumPkg/Common.fdf.inc
